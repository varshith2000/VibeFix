# Copy to .env and fill in. This template is committed; real values never are.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# --- Control-plane security (all optional; defaults are safe) ---
# API token required on every endpoint. If unset, a strong random token is
# generated once and stored (mode 0600) at ~/.vibefix/server-token — the Vite
# dev/preview proxy reads that file and injects the header automatically.
# Delete the file to rotate. Set explicitly only if you need a fixed value.
#VIBEFIX_API_TOKEN=
# Comma-separated browser origins allowed to reach the API (default:
# http://localhost:5173,http://127.0.0.1:5173).
#VIBEFIX_UI_ORIGIN=
# Host to bind (default 127.0.0.1). Non-loopback binding requires BOTH
# VIBEFIX_ALLOW_REMOTE=1 and an explicit VIBEFIX_API_TOKEN (>=16 chars).
#VIBEFIX_HOST=127.0.0.1
#VIBEFIX_PORT=8630
#VIBEFIX_ALLOW_REMOTE=
# Extra hosts the GitHub-clone endpoint may clone from (comma-separated).
#VIBEFIX_CLONE_HOSTS=
# Max simultaneously-active runs (default 4).
#VIBEFIX_MAX_ACTIVE_RUNS=
